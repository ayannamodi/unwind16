{
  "manifest_version": 3,
  "name": "Unwind ’16: Nostalgia Study Companion",
  "version": "1.0.0",
  "description": "Detox from modern doomscrolling with low-stim 2016 tactile fidgets and focus timers.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage", "alarms"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Unwind ’16",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
